# Root-level .env for Supabase CLI
# This file is used by `supabase` CLI commands
# Place in the project root (same directory as supabase/ folder)

# Production Supabase Project
SUPABASE_PROJECT_ID=your-project-id-here
SUPABASE_DB_PASSWORD=your-database-password

# These are automatically available when running `supabase start`
# but you may want to set them explicitly for CI/CD
# SUPABASE_URL=http://localhost:54321
# SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
