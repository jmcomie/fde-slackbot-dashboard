# Supabase Configuration (auto-injected by Supabase, DO NOT define here)
# The following variables are automatically available in edge functions:
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_DB_URL
# DO NOT add any variables starting with SUPABASE_ here!

# OpenAI Configuration
OPENAI_API_KEY=your-openai-key-here

# Slack Configuration
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Python Backend URL (for message processing)
# Local development: Use host.docker.internal to reach host machine from Docker container
# Production: your deployed backend URL (e.g., https://your-backend.railway.app)
BACKEND_URL=http://host.docker.internal:8000

# Optional: For additional integrations
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
